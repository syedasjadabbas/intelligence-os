# ==============================================================================
# Intelligence OS - Backend Environment Configuration (.env.example)
# ==============================================================================

# Application & Environment
PROJECT_NAME="Intelligence OS"
VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database (pgvector/pgvector:pg16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=intelligence_os
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intelligence_os
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intelligence_os

# Redis Cache & Message Broker (redis:7-alpine)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Security & Authentication (JWT)
JWT_SECRET_KEY=dev-secret-key-change-this-in-production-min-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Vector Embeddings & Hybrid Search (Step 4)
OPENAI_API_KEY=
COHERE_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
RRF_K=60

# Step 5: LLM Generation, Cross-Encoder Reranker & Guardrails
LLM_PROVIDER=gemini
LLM_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=4
MAX_CONTEXT_TOKENS=2000
INSUFFICIENT_EVIDENCE_PHRASE=I cannot find sufficient evidence in the organization's documents to answer this question.
